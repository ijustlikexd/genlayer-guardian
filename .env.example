# Hex-encoded secp256k1 private key of the keeper's signing account ("0x...").
# The keeper submits `check` transactions on this account's behalf. No funds
# are held; this key only needs enough gas allowance for the target network.
ACCOUNT_PRIVATE_KEY=

# GenLayer network to talk to. One of: localnet, studionet, testnet-asimov,
# testnet-bradbury. See keeper/client.ts for the full chain map.
GENLAYER_NETWORK=studionet

# Deployed Guardian contract address ("0x...").
GUARDIAN_ADDRESS=
